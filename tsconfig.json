{
    "compilerOptions": {
        "module": "nodenext", // or ES2015, ES2020
        "moduleResolution": "nodenext",
        "allowImportingTsExtensions": true,
        "noEmit": true,
        "types": ["node"]
    },
    "exclude": ["node_modules", "test.ts"],
    "ts-node": {
        // Tell ts-node CLI to install the --loader automatically
        "esm": true,
    }
}