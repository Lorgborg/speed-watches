# Copy to .env and fill in real values. .env is gitignored; .env.example is committed.

# --- Required ---
# Riot API keys (dev keys from https://developer.riotgames.com)
# leagueApi1 is the canonical identity token. leagueApi2+ are worker tokens.
leagueApi1=
leagueApi2=
leagueApi3=
leagueApi4=
leagueApi5=

# Riot "aggregator" key used only by the one-time backfill (immigrant-scum.ts)
aggregatorApi=

# PostgreSQL connection string
postgresuri=postgres://user:pass@localhost:5432/speedwatches

# Redis connection string (BullMQ queues + rate limiting + puuid cache)
redisUri=redis://127.0.0.1:6379

# API key auth. Requests must send `Authorization: Bearer <key>`.
#   dev:   read-only (GET only), strict rate limit (30 req / 10 min)
#   admin: full access, 120 req / min
DEV_API_KEY=822e6962cfcf93a42668050dd8aa3b77e6c1b75909762d9d
ADMIN_API_KEY=
